NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://tubexai.com.br
OWNER_EMAILS=
OWNER_USER_IDS=
NEXT_PUBLIC_OWNER_EMAIL=
NEXT_PUBLIC_OWNER_EMAILS=
NEXT_PUBLIC_OWNER_USER_IDS=

# O Workspace SEO usa diretamente o mesmo backend e a mesma chave do TubeX Analyzer.
# Não é necessário configurar TUBEX_BACKEND_API_KEY ou TUBEX_BACKEND_URL.

# E-mails transacionais das solicitações de cancelamento (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TubeX <nao-responda@seudominio.com>
CANCELLATION_NOTIFICATION_EMAIL=gabrielbzago@gmail.com

# Protege a rotina semanal de resumo de conquistas no Vercel Cron
CRON_SECRET=

# TubeX AI — chat de texto via Groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Geração de thumbnails (continua separada do chat; requer provedor de imagens)
OPENAI_API_KEY=

# TubeX AI — pacotes de créditos avulsos (OPCIONAL). Sem estes, o checkout usa os
# valores de lib/tubex-ai-packs.ts. Se criar os Prices na Stripe, use o MESMO valor.
STRIPE_PRICE_AI_PACK_300=
STRIPE_PRICE_AI_PACK_1000=
STRIPE_PRICE_AI_PACK_3000=

# YouTube / YouTube Analytics — renovação automática do acesso do Google (sem reconectar a cada 1h).
# Use o MESMO Client ID/Secret do provedor Google configurado no Supabase (Authentication > Providers > Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: chave própria para criptografar os refresh tokens (padrão: derivada da SUPABASE_SERVICE_ROLE_KEY).
GOOGLE_TOKEN_SECRET=
